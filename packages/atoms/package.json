{
  "name": "@calendoro/atoms",
  "version": "0.1.0",
  "description": "React components for embedding Calendoro booking in your own app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calendoro/calendoro-node.git",
    "directory": "packages/atoms"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@calendoro/sdk": "^0.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
