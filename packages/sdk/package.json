{
  "name": "@calendoro/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Calendoro scheduling API: typed methods, retries, timeouts, idempotency and pagination.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calendoro/calendoro-node.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
